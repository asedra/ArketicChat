{
  "name": "attila-ai-enhanced-function-management",
  "version": "1.0.0",
  "description": "AI-powered function orchestration platform with intelligent routing and multi-function execution",
  "private": true,
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .js,.ts,.svelte",
    "lint:fix": "eslint . --ext .js,.ts,.svelte --fix",
    "format": "prettier --write .",
    "backend": "cd backend && uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "start": "concurrently \"npm run backend\" \"npm run dev\"",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@sveltejs/adapter-auto": "^2.1.1",
    "@sveltejs/kit": "^1.27.4",
    "@sveltejs/vite-plugin-svelte": "^2.5.3",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.35.1",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "prettier-plugin-svelte": "^3.1.2",
    "svelte": "^4.2.7",
    "svelte-check": "^3.6.2",
    "tailwindcss": "^3.3.6",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^1.1.0"
  },
  "dependencies": {
    "@monaco-editor/loader": "^1.4.0",
    "chart.js": "^4.4.1",
    "concurrently": "^8.2.2",
    "crypto-js": "^4.2.0",
    "d3": "^7.8.5",
    "dompurify": "^3.0.6",
    "lucide-svelte": "^0.294.0",
    "monaco-editor": "^0.45.0"
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "function-management",
    "orchestration",
    "svelte",
    "fastapi",
    "routing",
    "automation"
  ],
  "author": "ATTILA AI Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/attila-ai-enhanced-function-management"
  },
  "bugs": {
    "url": "https://github.com/your-org/attila-ai-enhanced-function-management/issues"
  },
  "homepage": "https://github.com/your-org/attila-ai-enhanced-function-management#readme"
}